# custom type: a collection of 3 numbers, one per savings account
type savings start
    number[3]
end

# custom type client, which uses the savings type
type client start
    var name is text
    var savings is savings
    var total_savings is number
end

var my_savings is savings
var total_savings is number
var bank_account is client

my_savings -> savings(1000, 15000, 932)
total_savings -> my_savings[0] + my_savings[1]
total_savings -> total_savings + my_savings[2]

# create the client and fill in its members
bank_account -> client("Test", my_savings, total_savings)

print("My back account details:", bank_account)
